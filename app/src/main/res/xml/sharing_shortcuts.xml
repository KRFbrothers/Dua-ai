<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Direct Share: recent Dua chats published by ChatShortcuts with this category. -->
    <share-target android:targetClass="com.dua.ai.MainActivity">
        <data android:mimeType="text/plain" />
        <category android:name="com.dua.ai.category.CHAT_SHARE_TARGET" />
    </share-target>
    <share-target android:targetClass="com.dua.ai.MainActivity">
        <data android:mimeType="image/*" />
        <category android:name="com.dua.ai.category.CHAT_SHARE_TARGET" />
    </share-target>
</shortcuts>
