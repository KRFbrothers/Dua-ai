# Cloud Run / local Python engine settings. See README.md and ../README.md.
# Copy to ignored .env for local use. Python does NOT load it automatically:
# from this directory, after editing your trusted file:
#   set -a
#   . ./.env
#   set +a
#   python app.py
# Use shell-compatible assignments; quote values containing spaces, # or shell
# metacharacters. Production values belong in Cloud Run / Secret Manager.
# Never commit .env or any provider, account or GitHub credentials.

# Required Vertex project. Generation uses Google runtime credentials / ADC
# with Vertex permissions, not a GEMINI_API_KEY. Do not paste service-account
# JSON into this file; prefer the deployed service's Google service account.
GOOGLE_CLOUD_PROJECT=
VERTEX_LOCATION=global
VERTEX_MODEL=gemini-3.8-flash
VERTEX_THINKING_LEVEL=low

# Required owner authentication: same Auth project and owner as dua-api.
# HTTPS project root only (https://PROJECT.supabase.co), never /rest/v1/.
SUPABASE_URL=
# Public publishable key preferred, or uncomment SUPABASE_ANON_KEY below.
# Do not use a service-role/secret key. No user access token belongs here.
SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_ANON_KEY=
DUA_ALLOWED_EMAIL=
# Owner verification is mandatory. DUA_REQUIRE_LOGIN=0 cannot disable it.

# Optional additional gate (SECRET), never a replacement for owner login.
# If set, Android must be built with the matching DUA_APP_TOKEN / duaAppToken.
# An APK-embedded value is extractable; do not use it as sole authentication.
DUA_APP_TOKEN=

# Dua AI website (browser) access. Comma-separated exact origins; "off" disables.
# Default when unset: https://dua-api-228305912525.us-central1.run.app,http://localhost:5173
# WEB_ORIGINS=
# 1 = requests from an allowed website origin skip DUA_APP_TOKEN (a browser cannot keep it
# secret). Owner login is still required. Default off.
# WEB_SKIP_APP_TOKEN=0

# Optional write-capable coding agent, unavailable without a token.
# SECRET: fine-grained, selected repo, Contents + Pull requests read/write.
# Separate from the Node API's read-only and owner-confirmed Build PR tokens.
GITHUB_TOKEN=
# Set an explicit owner/repo before enabling coding. An empty value blocks
# coding instead of falling back to the code's default KRFbrothers/Dua-ai.
DUA_REPO=
# Coding runs can create a new dua-agent/* branch and PR during an agent task;
# they do not use the Node API's separate Create PR confirmation endpoint.
# Runtime caps (defaults shown):
# CODING_MAX_STEPS=15
# CODING_MAX_SECONDS=600
# CODING_STEP_TOKENS=16384

# Optional Agent output caps (defaults include thinking tokens).
# AGENT_ANSWER_TOKENS=4096
# AGENT_ROUTER_TOKENS=256

# Local development only. Cloud Run supplies PORT; do not override it there.
PORT=8080

# Cloud Run runtime settings live on the service; see README.md "Redeploy from Cloud Shell".
