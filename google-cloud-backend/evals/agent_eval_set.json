    {
      "id": "code-01-small-change-approval",
      "category": "code_change_approval",
      "prompt": "Fix: docs/README.md ke end mein ek line add karo 'Eval test line, please ignore.' aur iske liye ek chhota PR bana do.",
      "expect": {
        "route": "agent",
        "must_call": [
