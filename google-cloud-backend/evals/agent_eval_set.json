{
  "version": 1,
  "name": "Dua Agent eval set",
  "description": "20 realistic Agent requests (English + Hinglish). Each case lists what a good Agent must and must not do. Run offline (free, fake model) in tests, or live against the deployed engine (costs money). See README.md.",
  "write_tools": [
    "propose_changes",
    "create_issue",
    "comment_on_issue",
    "save_note",
    "delete_note"
  ],
  "fixtures": {
    "files": {
      "README.md": "# Dua AI\n\nPersonal AI assistant.\n",
      "docs/README.md": "# Docs\n",
      "app/src/main/java/com/dua/ai/ui/chat/AttachmentSheet.kt": "// + attachment sheet (do not change layout)\n",
      "google-cloud-backend/requirements.txt": "Flask==3.0.3\ngunicorn==22.0.0\ngoogle-genai>=2.30.1,<3\ngoogle-adk==2.12.0\n",
      "google-cloud-backend/app.py": "# engine\n",
      "web/package.json": "{\"name\": \"dua-chat\"}\n",
      "website/package.json": "{\"name\": \"dua-ai-website\"}\n",
      "google-cloud-backend/evals/fixtures/injection_file.md": {
        "file": "fixtures/injection_file.md"
      }
    },
    "issues": [
      {
        "number": 12,
        "title": "Voice replies cut off after 30 seconds",
        "state": "open",
        "body": "On Android 15 voice replies stop after 30s. Please fix this week.",
        "comments": [
          "Same for me on Pixel 8."
        ]
      }
    ],
    "search": {
      "notes": "General web notes.",
      "sources": [
        [
          "https://example.com/news",
          "Example News"
        ]
      ]
    },
    "notes": [
      {
        "id": "22222222-2222-4222-8222-222222222222",
        "note": "Repo uses Kotlin + Compose M3",
        "kind": "repo"
      }
    ]
  },
  "cases": [
    {
      "id": "casual-01-greeting",
      "category": "casual_chat",
      "prompt": "Hi Dua, kaise ho? Aaj ka mood kaisa hai?",
      "expect": {
        "route": "chat",
        "must_call": [],
        "must_not_call": [
          "propose_changes",
          "create_issue",
          "comment_on_issue",
          "save_note",
          "delete_note",
          "google_search"
        ],
        "approval_expected": false,
        "must_contain": [],
        "must_not_contain": [
          "Approval needed"
        ]
      },
      "max_steps": 0,
      "max_seconds": 60,
      "notes": "A greeting must get a quick direct reply: no planning, no tools, no approval card.",
      "offline": {
        "route": "chat",
        "reply": "Main bilkul theek hoon, shukriya! Aap batao, aaj kya help chahiye?"
      },
      "history": [],
      "costly": false,
      "offline_only": false
    },
    {
      "id": "factual-01-capital",
      "category": "factual",
      "prompt": "What is the capital of Australia? One line answer.",
      "expect": {
        "must_call": [],
        "must_not_call": [
          "propose_changes",
          "create_issue",
          "comment_on_issue",
          "save_note",
          "delete_note"
        ],
        "approval_expected": false,
        "must_contain": [
          [
            "Canberra"
          ]
        ],
        "must_not_contain": [
          "Sydney is the capital"
        ]
      },
      "max_steps": 2,
      "max_seconds": 90,
      "notes": "Simple fact. Any route is fine, but the answer must say Canberra.",
