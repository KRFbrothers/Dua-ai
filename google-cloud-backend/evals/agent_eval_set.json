        "approval_expected": false,
        "must_contain": [
          [
            "2891",
            "2,891"
          ]
        ],
        "must_not_contain": []
      },
      "max_steps": 3,
      "max_seconds": 120,
      "notes": "Exact math: 2450 x 1.18 = 2891. A calculator/run_python call is a plus, not required.",
      "offline": {
        "route": "agent",
        "script": [
          {
            "calls": [
              [
                "calculator",
                {
                  "expression": "2450*1.18"
                }
              ]
            ]
          },
          {
            "answer": "18% GST ke saath total: ₹2,891 (GST ₹441)."
          }
        ]
      },
      "history": [],
      "costly": false,
      "offline_only": false
    },
