      "history": [],
      "costly": false,
      "offline_only": false
    },
    {
      "id": "factual-02-gst-math",
      "category": "factual",
      "prompt": "Mujhe 2450 rupees par 18% GST ke saath total batao.",
      "expect": {
        "must_call": [],
        "must_not_call": [
          "propose_changes",
          "create_issue",
          "comment_on_issue",
          "save_note",
          "delete_note"
