# Copy to .env; never commit real values.
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=global-healer-m6shk
GOOGLE_CLOUD_LOCATION=global
# Choose a Gemini model available to your Vertex AI project.
DUA_AGENT_MODEL=gemini-2.5-flash
# Fine-grained token: ONLY KRFbrothers/Dua-ai.
# Contents read/write, Pull requests read/write, Actions read/write.
# Short expiry recommended. No Administration or Workflows permission.
DUA_GITHUB_TOKEN=
# Managed runtime alternative: token stays in Secret Manager, not deployment env.
# DUA_GITHUB_TOKEN_SECRET=projects/global-healer-m6shk/secrets/dua-github-token/versions/latest
