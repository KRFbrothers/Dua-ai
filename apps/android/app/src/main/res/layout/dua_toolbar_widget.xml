<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="8dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="64dp"
        android:orientation="horizontal" android:gravity="center_vertical" android:padding="8dp"
        android:background="@drawable/widget_pill">
        <LinearLayout android:id="@+id/widget_query" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="48dp" android:orientation="horizontal" android:gravity="center_vertical"
            android:contentDescription="@string/widget_query" android:focusable="true">
            <ImageView android:layout_width="24dp" android:layout_height="24dp" android:layout_marginStart="4dp"
                android:src="@drawable/gs_spark" android:importantForAccessibility="no" />
            <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                android:layout_marginHorizontal="8dp" android:text="@string/widget_query"
                android:textSize="@dimen/dua_widget_text" android:textColor="@color/dua_widget_icon"
                android:maxLines="1" android:ellipsize="end" android:importantForAccessibility="no" />
        </LinearLayout>
        <ImageButton android:id="@+id/widget_mic" android:layout_width="48dp" android:layout_height="48dp"
            android:padding="12dp" android:src="@drawable/widget_mic" android:background="@android:color/transparent"
            android:contentDescription="@string/widget_mic" />
        <ImageButton android:id="@+id/widget_live" android:layout_width="48dp" android:layout_height="48dp"
            android:padding="12dp" android:src="@drawable/ls_live_wave" android:tint="@color/dua_widget_on_purple"
            android:background="@drawable/widget_live_circle" android:contentDescription="@string/widget_live" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="8dp">
        <FrameLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent">
            <ImageButton android:id="@+id/widget_camera" android:layout_width="48dp" android:layout_height="48dp" android:layout_gravity="center"
                android:padding="12dp" android:src="@drawable/gs_camera" android:background="@drawable/widget_circle" android:contentDescription="@string/widget_camera" />
        </FrameLayout>
        <FrameLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent">
            <ImageButton android:id="@+id/widget_photos" android:layout_width="48dp" android:layout_height="48dp" android:layout_gravity="center"
                android:padding="12dp" android:src="@drawable/widget_photos" android:background="@drawable/widget_circle" android:contentDescription="@string/widget_photos" />
        </FrameLayout>
        <FrameLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent">
            <ImageButton android:id="@+id/widget_files" android:layout_width="48dp" android:layout_height="48dp" android:layout_gravity="center"
                android:padding="12dp" android:src="@drawable/widget_files" android:background="@drawable/widget_circle" android:contentDescription="@string/widget_files" />
        </FrameLayout>
        <FrameLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent">
            <ImageButton android:id="@+id/widget_screenshare" android:layout_width="48dp" android:layout_height="48dp" android:layout_gravity="center"
                android:padding="12dp" android:src="@drawable/gs_screenshare" android:background="@drawable/widget_circle" android:contentDescription="@string/widget_screenshare" />
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
