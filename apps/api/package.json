{
  "name": "dua-chat",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server/server.mjs",
    "test": "node --test \"test/**/*.test.mjs\"",
    "test:ci": "node --test --test-reporter=spec --test-reporter-destination=stdout --test-reporter=junit --test-reporter-destination=backend-test-results.xml \"test/**/*.test.mjs\"",
    "verify:rls": "node scripts/verify-rls.mjs"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "unpdf": "1.9.1",
    "cfb": "1.2.2"
  }
}
