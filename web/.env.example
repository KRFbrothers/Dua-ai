# Local Node API / Vercel settings. See ../README.md, ../SUPABASE.md and
# ../PROVIDERS.md for setup, migrations and optional tuning variables.
# Copy to ignored web/.env; npm start loads it with Node 24+.
# This template contains no credentials. Fill only the integrations you use.
# Keep provider keys, GitHub tokens and the service-role key server-side.
# Quote values containing spaces, # or shell metacharacters.

# Local server only; Vercel supplies its own listening configuration.
PORT=3000

# Required for the intended owner-only setup. Do not disable login to work
# around missing Auth settings. Blank setup intentionally leaves AI unavailable.
DUA_REQUIRE_LOGIN=1
DUA_ALLOWED_EMAIL=
SUPABASE_URL=
# Use the HTTPS project root (https://PROJECT.supabase.co), not /rest/v1/.
# Public publishable/anon credential only; never a service-role/secret key here.
SUPABASE_ANON_KEY=

# Optional admin credential for account deletion and durable daily request limits.
# SECRET: not needed for normal sign-in, snapshots or stored files.
SUPABASE_SERVICE_ROLE_KEY=
# Set a positive integer only after the usage migration; no limit when omitted.
# DUA_DAILY_REQUEST_LIMIT=

# Optional Vercel chat providers: each needs BOTH its secret API key and model ID.
# These keys are unnecessary for chat routed to the separate Vertex engine.
# Model IDs are left empty: choose IDs available to your provider account.
GEMINI_API_KEY=
GEMINI_MODEL=
OPENAI_API_KEY=
OPENAI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
GROK_API_KEY=
GROK_MODEL=
KIMI_API_KEY=
KIMI_MODEL=
# Optional chat tuning (defaults shown). Keep deadline below hosting duration.
# DUA_CHAT_DEADLINE_SECONDS=280
# GEMINI_THINKING_LEVEL=high
# Non-Gemini image/PDF input requires model support and explicit opt-in;
# see <PREFIX>_ATTACHMENT_TYPES in PROVIDERS.md before enabling it.

# Optional Brave Search fallback / search integration (SECRET).
BRAVE_SEARCH_API_KEY=

# Optional GitHub reads: fine-grained, selected repositories, Contents/Metadata
# read-only. This token must remain separate from either write-capable token.
ENABLE_GITHUB_CONNECTOR=0
GITHUB_CONNECTOR_TOKEN=
# DUA_BUILD_MAX_ROUNDS=6
# DUA_BUILD_MAX_FILES=40
# DUA_BUILD_FILE_MAX_KB=100
# DUA_BUILD_MAX_KB=600

# Optional owner-confirmed Build PR creation (off by default).
# SECRET: separate token, selected repos, Contents + Pull requests read/write.
DUA_BUILD_PR=0
GITHUB_BUILD_WRITE_TOKEN=
# Set explicit comma-separated owner/repo entries before enabling writes.
# Omitted/empty means repositories owned by the write-token account, not no repos.
DUA_BUILD_PR_REPOS=
# DUA_BUILD_PR_DRAFT=1
# DUA_BUILD_PR_MAX_FILES=20
# DUA_BUILD_PR_FILE_MAX_KB=200
# DUA_BUILD_PR_MAX_KB=1024

# Optional stored files: stay off until the private bucket + Storage migration
# are installed. Then set DUA_FILES=1 explicitly; runtime otherwise defaults on
# once Supabase is configured. Limits below show the runtime defaults.
# Do not raise limits beyond the Supabase bucket/plan limits.
DUA_FILES=0
# DUA_FILES_BUCKET=dua-files
# DUA_FILES_MAX_MB=50
# DUA_HISTORY_FILES=4
# DUA_FILE_TEXT_MAX_CHARS=150000
# DUA_SHEET_MAX_ROWS=300
# DUA_SHEET_MAX_COLS=40
# DUA_SHEET_MAX_CHARS=120000
# Audio transcription can use configured Grok, Gemini or OpenAI credentials.
# DUA_TRANSCRIBE_PROVIDER=auto

# Optional provider-hosted Run code: no code runs on this server or the phone.
# Set DUA_CODE_EXECUTION=0 to disable it; Gemini defaults on when configured.
# OpenAI/Grok tools have separate billing and require explicit opt-in.
# OPENAI_CODE_EXECUTION=0
# GROK_CODE_EXECUTION=0

# Optional Imagine / voice reuse provider keys above; adding a key can make
# these features available when owner auth, storage and migrations are ready.
# Set the following switches to 0 in .env if you want these features disabled.
# DUA_IMAGINE_IMAGE=0
# DUA_IMAGINE_VIDEO=0
# DUA_VOICE_TTS=0
# DUA_VOICE_REALTIME=0
# Optional caps (runtime defaults shown); migrations enforce Imagine/live usage.
# DUA_IMAGINE_DAILY_IMAGES=20
# DUA_IMAGINE_DAILY_VIDEO_SECONDS=60
# DUA_VOICE_DAILY_MINUTES=30
# DUA_VOICE_SESSION_MAX_MINUTES=10

# Optional ElevenLabs reply voice: separate opt-in and SECRET API key.
ENABLE_GENERATED_VOICE=0
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Android URL/OAuth/signing inputs belong to the Android build, not this file.
# Cloud Run's GITHUB_TOKEN / Vertex credentials belong to its own environment.
