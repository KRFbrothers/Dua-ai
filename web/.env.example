# Copy locally to .env (ignored), or add each variable in Vercel project settings.
# Private keys are SERVER ONLY. Do not put them in HTML, Android or chat.
GEMINI_API_KEY=
GEMINI_MODEL=
SUPABASE_URL=https://gmjzshgzdaizfximuhsf.supabase.co
SUPABASE_ANON_KEY=
# Optional providers: choose current model IDs in provider dashboards.
OPENAI_API_KEY=
OPENAI_MODEL=
# TXT works by default. Opt in only to MIME types supported by your API model.
# Example: image/jpeg,image/png,image/webp,application/pdf
OPENAI_ATTACHMENT_TYPES=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
ANTHROPIC_ATTACHMENT_TYPES=
GROK_API_KEY=
GROK_MODEL=
# Grok/Kimi adapters allow image/jpeg,image/png,image/webp; PDF is unsupported.
GROK_ATTACHMENT_TYPES=
KIMI_API_KEY=
KIMI_MODEL=
KIMI_ATTACHMENT_TYPES=
BRAVE_SEARCH_API_KEY=
# Personal access: set1 and your login email after validating sign-in.
DUA_REQUIRE_LOGIN=0
DUA_ALLOWED_EMAIL=
# Optional durable requestcount. Requires secondSQL migration andadmin key.
DUA_DAILY_REQUEST_LIMIT=
SUPABASE_SERVICE_ROLE_KEY=
# Googlelogin requires Supabase Googleprovider + redirectallowlist.
SUPABASE_AUTH_REDIRECT_URL=https://dua-cyan.vercel.app/api/account/oauth/callback
# Sharedconnector/audio require allowedowneremail andsign-in.
ENABLE_GITHUB_CONNECTOR=0
GITHUB_CONNECTOR_TOKEN=
ENABLE_GENERATED_VOICE=0
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
